#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

if [[ ! -d .venv ]]; then
  echo "Installing Python dependencies…"
  uv sync --extra dev
fi

if [[ ! -d node_modules || ! -d apps/web/node_modules ]]; then
  echo "Installing frontend dependencies…"
  pnpm install
fi

if [[ ! -f .env && -f .env.example ]]; then
  cp .env.example .env
fi

api_pid=""
web_pid=""

kill_tree() {
  local pid="${1:-}"
  if [[ -z "$pid" ]] || ! kill -0 "$pid" 2>/dev/null; then
    return 0
  fi
  pkill -P "$pid" 2>/dev/null || true
  kill "$pid" 2>/dev/null || true
}

cleanup() {
  trap - INT TERM EXIT
  kill_tree "$web_pid"
  kill_tree "$api_pid"
  wait 2>/dev/null || true
}

trap cleanup INT TERM EXIT

echo "Starting RockyRoad API on http://127.0.0.1:8000"
uv run rockyroad-api &
api_pid=$!

echo "Starting RockyRoad web on http://127.0.0.1:5173"
pnpm dev &
web_pid=$!

for _ in $(seq 1 40); do
  if curl -sf "http://127.0.0.1:8000/api/health" >/dev/null; then
    break
  fi
  sleep 0.25
done

if ! curl -sf "http://127.0.0.1:8002/status" >/dev/null 2>&1; then
  echo "Valhalla is not on :8002. Routes will fail until routing tiles are served."
  echo "Build them with: uv run rockyroad-data build-routing"
  echo "Then publish Valhalla to the host with: docker compose up -d valhalla"
fi

if ! curl -sf -o /dev/null "http://127.0.0.1:8000/maps/north-america.pmtiles"; then
  echo "PMTiles are not built yet (GET /maps/north-america.pmtiles → 404)."
  echo "  uv run rockyroad-data update-osm --profile sample"
  echo "  uv run rockyroad-data build-map"
  echo "  uv run rockyroad-data build-places"
fi

echo
echo "RockyRoad is running."
echo "  App  http://127.0.0.1:5173"
echo "  API  http://127.0.0.1:8000/api/health"
echo "  Maps http://127.0.0.1:8000/maps/north-america.pmtiles"
echo

wait "$api_pid" "$web_pid"
