{
  admin off
  auto_https off
}

:80 {
  encode gzip

  handle /api/* {
    reverse_proxy api:8000
  }

  handle /maps/* {
    root * /srv
    @pmtiles path *.pmtiles
    header @pmtiles Cache-Control "public, max-age=31536000, immutable"
    header Accept-Ranges bytes
    file_server
  }

  handle /map/* {
    root * /srv/web/public
    file_server
  }

  handle {
    root * /srv/web
    try_files {path} /index.html
    file_server
  }
}
