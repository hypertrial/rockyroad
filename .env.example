ROCKYROAD_PROVIDER_MODE=hosted
ROCKYROAD_ORS_API_KEY=
# Optional provider overrides for tests or self-hosted instances:
# ROCKYROAD_ORS_BASE_URL=https://api.heigit.org/openrouteservice
# ROCKYROAD_ORS_OPTIMIZATION_URL=https://api.heigit.org/vroom/v0/optimization
# ROCKYROAD_PHOTON_URL=https://photon.komoot.io
# ROCKYROAD_PHOTON_USER_AGENT=RockyRoad/0.1 (personal Canada+USA road-trip planner)
# ROCKYROAD_OPENFREEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
ROCKYROAD_DUCKDB_PATH=data/rockyroad.duckdb
ROCKYROAD_GEO_DIR=data/geo
ROCKYROAD_MAPS_DIR=data/maps
ROCKYROAD_OSM_DIR=data/osm
ROCKYROAD_ROUTING_DIR=data/routing/valhalla
# Local/offline PEI stack: set ROCKYROAD_PROVIDER_MODE=local, then build artifacts
# and start Valhalla with: docker compose --profile local up -d valhalla
# Set this when the repo path contains a space so Compose can bind Valhalla tiles:
# ROCKYROAD_VALHALLA_FILES=/Users/you/.cache/rockyroad/valhalla
# Planetiler heap for build-map. Sample is fine at 4g; use 32g for canada-usa.
# ROCKYROAD_PLANETILER_XMX=4g
VALHALLA_URL=http://127.0.0.1:8002
VALHALLA_TIMEOUT_S=30
ROCKYROAD_API_HOST=127.0.0.1
ROCKYROAD_API_PORT=8000
