#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

if [[ ! -d .venv ]]; then
  echo "Installing Python dependencies…"
  uv sync --extra dev
fi

if [[ ! -d node_modules || ! -d apps/web/node_modules ]]; then
  echo "Installing frontend dependencies…"
  pnpm install
fi

if [[ ! -f .env && -f .env.example ]]; then
  cp .env.example .env
fi

api_pid=""
web_pid=""

kill_tree() {
  local pid="${1:-}"
  if [[ -z "$pid" ]] || ! kill -0 "$pid" 2>/dev/null; then
    return 0
  fi
  pkill -P "$pid" 2>/dev/null || true
  kill "$pid" 2>/dev/null || true
}

cleanup() {
  trap - INT TERM EXIT
  kill_tree "$web_pid"
  kill_tree "$api_pid"
  wait 2>/dev/null || true
}

trap cleanup INT TERM EXIT

if curl -sf --connect-timeout 1 --max-time 1 "http://127.0.0.1:8000/api/ready" >/dev/null 2>&1; then
  echo "Port 8000 is already in use. Stop the other RockyRoad API and rerun ./scripts/dev."
  exit 1
fi

export PYTHONPATH="$root/services/api/src${PYTHONPATH:+:$PYTHONPATH}"

echo "Starting RockyRoad API on http://127.0.0.1:8000"
uv run rockyroad-api &
api_pid=$!

api_timeout_seconds="${ROCKYROAD_DEV_API_TIMEOUT_SECONDS:-120}"
if [[ ! "$api_timeout_seconds" =~ ^[1-9][0-9]*$ ]]; then
  echo "ROCKYROAD_DEV_API_TIMEOUT_SECONDS must be a positive whole number."
  exit 1
fi

ready=0
started_at=$SECONDS
next_progress=10
while ((SECONDS - started_at < api_timeout_seconds)); do
  if ! kill -0 "$api_pid" 2>/dev/null; then
    echo "API process exited before it became ready."
    exit 1
  fi
  if curl -sf --connect-timeout 1 --max-time 1 "http://127.0.0.1:8000/api/health" >/dev/null; then
    ready=1
    break
  fi
  elapsed=$((SECONDS - started_at))
  if ((elapsed >= next_progress)); then
    echo "API is still starting (${elapsed}s elapsed; timeout ${api_timeout_seconds}s)."
    next_progress=$((next_progress + 10))
  fi
  sleep 0.25
done

if [[ "$ready" -ne 1 ]]; then
  echo "API did not become ready within ${api_timeout_seconds}s on http://127.0.0.1:8000/api/health"
  echo "Review the API startup output above, or run this command directly for diagnostics:"
  echo "  PYTHONPATH=services/api/src uv run rockyroad-api"
  echo "For unusually slow first-time setup, retry with a larger timeout:"
  echo "  ROCKYROAD_DEV_API_TIMEOUT_SECONDS=240 ./scripts/dev"
  exit 1
fi

echo "Starting RockyRoad web on http://127.0.0.1:5173"
pnpm dev &
web_pid=$!

provider_mode=""
if [[ "${ROCKYROAD_PROVIDER_MODE+x}" == "x" ]]; then
  provider_mode="$ROCKYROAD_PROVIDER_MODE"
elif [[ -f .env ]]; then
  provider_mode="$(awk -F= '/^ROCKYROAD_PROVIDER_MODE=/{value=$2} END{print value}' .env | tr -d '[:space:]' | tr -d "\"'")"
fi
provider_mode="${provider_mode:-hosted}"

if [[ "$provider_mode" == "local" ]]; then
  if ! curl -sf "http://127.0.0.1:8002/status" >/dev/null 2>&1; then
    echo "Valhalla is not on :8002. Routes will fail until routing tiles are served."
    echo "Build them with: uv run rockyroad-data build-routing"
    if docker compose version >/dev/null 2>&1; then
      compose_cmd="docker compose"
    elif command -v docker-compose >/dev/null 2>&1; then
      compose_cmd="docker-compose"
    else
      compose_cmd="docker compose"
    fi
    echo "Then publish Valhalla to the host with: ${compose_cmd} --profile local up -d valhalla"
    if [[ "$root" == *" "* ]]; then
      echo "This repo path has a space; Compose must bind a Docker-visible copy:"
      echo "  export ROCKYROAD_VALHALLA_FILES=\"\$HOME/.cache/rockyroad/valhalla\""
    fi
  fi

  maps_code="$(curl -sS -o /dev/null -w '%{http_code}' -r 0-0 "http://127.0.0.1:8000/maps/north-america.pmtiles" || true)"
  if [[ "${maps_code}" != "200" && "${maps_code}" != "206" && "${maps_code}" != "304" ]]; then
    echo "PMTiles are not built yet (GET /maps/north-america.pmtiles → ${maps_code:-failed})."
    echo "  uv run rockyroad-data update-osm --profile sample"
    echo "  uv run rockyroad-data build-map"
    echo "  uv run rockyroad-data build-places"
  fi
else
  ors_key=""
  if [[ "${ROCKYROAD_ORS_API_KEY+x}" == "x" ]]; then
    ors_key="$ROCKYROAD_ORS_API_KEY"
  elif [[ -f .env ]]; then
    ors_key="$(awk -F= '/^ROCKYROAD_ORS_API_KEY=/{value=$2} END{print value}' .env | tr -d '[:space:]' | tr -d "\"'")"
  fi
  if [[ -z "$ors_key" ]]; then
    echo "Hosted routing needs ROCKYROAD_ORS_API_KEY in .env (https://openrouteservice.org/)."
  fi
  echo "Hosted mode uses OpenFreeMap, OpenRouteService, and Photon. Set ROCKYROAD_PROVIDER_MODE=local for the PEI offline stack."
fi

echo
echo "RockyRoad is running."
echo "  App  http://127.0.0.1:5173"
echo "  API  http://127.0.0.1:8000/api/health"
if [[ "$provider_mode" == "local" ]]; then
  echo "  Maps http://127.0.0.1:8000/maps/north-america.pmtiles"
else
  echo "  Map  OpenFreeMap Liberty (see /api/health map_style_url)"
fi
echo

wait "$api_pid" "$web_pid"
